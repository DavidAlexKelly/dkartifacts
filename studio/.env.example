# Foundry hosting. Leave these unset to run against a local folder instead.
VITE_FOUNDRY_API_URL=https://your-enrollment.palantirfoundry.com
VITE_FOUNDRY_CLIENT_ID=
VITE_FOUNDRY_REDIRECT_URL=http://localhost:8080/auth/callback

# The catalog dataset (terrain-gen's out/catalog), so the studio opens on it.
VITE_STUDIO_CATALOG_RID=

# Local development: a terrain-gen output folder, served at /data/.
STUDIO_DATA=../terrain-gen/out
