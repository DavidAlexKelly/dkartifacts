{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Emit — unlike the app's tsconfig, this one produces output. */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",

    /* The sibling package resolves to its BUILT declarations, not its source,
       for the reason spelled out in @acc/decho-mil-map's build config: source
       would pull those files into this program and tsc would refuse to emit
       ("not under rootDir"). Declarations are never emitted, so this stays a
       pure type reference and the import specifier survives into dist exactly
       as written. `npm run build` builds it first. */
    "baseUrl": ".",
    "paths": {
      "@acc/decho-basemap": ["../decho-basemap/dist/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
