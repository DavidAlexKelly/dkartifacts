{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Emit — unlike the app's tsconfig, this one produces output. */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    /* composite: this config can be referenced by (and can reference) the
       sibling packages' build configs, so `tsc -b` builds them in dependency
       order and skips whatever is up to date. The build info lives in dist so
       that deleting dist always forces a rebuild; files[] keeps it out of the
       tarball. */
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",

    /* Sibling packages resolve to their SOURCE here, and the "references"
       below make that safe: in build mode tsc swaps every file of a referenced
       project for the declaration it emits, so nothing outside rootDir enters
       this program and the import specifier survives into dist exactly as
       written. `tsc -b` builds the references first. */
    "baseUrl": ".",
    "paths": {
      "@acc/decho-foundry-bytes": ["../decho-foundry-bytes/src/index.ts"],
      "@acc/decho-basemap": ["../decho-basemap/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"],
  "references": [
    { "path": "../decho-foundry-bytes/tsconfig.build.json" },
    { "path": "../decho-basemap/tsconfig.build.json" }
  ]
}
