{
  "name": "@acc/decho-components",
  "version": "0.4.0",
  "description": "The Decho component library: cards, tags, buttons, panels, nav items, an application shell, progress bars, metric tiles, dependency-free SVG charts and the rest of the pieces every operational front-end redraws. Styled from CSS custom properties with built-in fallbacks, so it looks right with no stylesheet, no provider and no dependency — and follows @acc/decho-styling's themes when they are present.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/scripts/**",
    "CHANGELOG.md",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/css/components.css"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "react-dom": "^18",
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.b39ad0fb-63f7-4297-9d23-d029564ce937/contents/release/npm/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "fallbacks": "node scripts/gen-fallbacks.mjs"
  }
}
