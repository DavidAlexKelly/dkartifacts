{
  "name": "@acc/decho-foundry-bytes",
  "version": "0.1.0",
  "description": "Read large files out of Foundry datasets and media sets from the browser: one token, a resident LRU, Cache Storage keyed by transaction RID, request de-duplication with refcounted cancellation, and concurrency lanes.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.df396b79-3da5-473f-91c2-7be67d95c46c/contents/release/npm/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@osdk/client": "^2.0.0",
    "@osdk/foundry.datasets": "^2.0.0",
    "@osdk/foundry.mediasets": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@osdk/foundry.mediasets": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  }
}
