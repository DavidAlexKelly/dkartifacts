{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    /* NodeNext, not bundler: dist is loaded by Node itself as well as by
       bundlers — Vitest, for one, hands node_modules to Node's own loader —
       and Node rejects extensionless and directory imports ("./core"). This
       makes the compiler insist on "./core/index.js" in the source, so dist is
       valid for both. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Emit — unlike the app's tsconfig, this one produces output. */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    /* composite: this config can be referenced by (and can reference) the
       sibling packages' build configs, so `tsc -b` builds them in dependency
       order and skips whatever is up to date. The build info lives in dist so
       that deleting dist always forces a rebuild; files[] keeps it out of the
       tarball. */
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"

    /* No "paths": nothing in this repo is above this package. */
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts"]
}
