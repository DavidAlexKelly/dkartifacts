{
  "name": "@acc/unit-symbol-picker",
  "version": "0.1.0",
  "description": "A compact APP-6D / MIL-STD-2525D unit symbol picker: the symbol in the middle, the SIDC above it, a dropdown per position below. Renders through milsymbol.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "schemas",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "CHANGELOG.md",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./tables": {
      "types": "./dist/tables.d.ts",
      "import": "./dist/tables.js"
    },
    "./tables/*": {
      "types": "./dist/core/generated/symbolSets/*.d.ts",
      "import": "./dist/core/generated/symbolSets/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.df396b79-3da5-473f-91c2-7be67d95c46c/contents/release/npm/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "generate": "node scripts/generate-tables.mjs",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "milsymbol": "^2.0.0 || ^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  }
}
