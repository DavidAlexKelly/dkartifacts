{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    /* Emit: tsc rather than tsup, because there is nothing to bundle — this
       package is a model plus one component, and its peers (react, milsymbol)
       stay external either way. */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    /* composite: this config can be referenced by (and can reference) the
       sibling packages' build configs, so `tsc -b` builds them in dependency
       order and skips whatever is up to date. The build info lives in dist so
       that deleting dist always forces a rebuild; files[] keeps it out of the
       tarball. */
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
