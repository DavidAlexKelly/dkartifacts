{
  "name": "@acc/decho-pathfinding",
  "version": "0.1.0",
  "description": "Terrain-aware routing over tiled pathfinding graphs served from Foundry. Headless — no map required — with an optional route layer and a drop-in OrderRouter for @acc/app6d/orders.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "import": "./dist/map/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.df396b79-3da5-473f-91c2-7be67d95c46c/contents/release/npm/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@acc/decho-foundry-bytes": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  }
}
