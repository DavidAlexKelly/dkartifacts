{
  "name": "@acc/app6d",
  "version": "3.7.0",
  "description": "Reusable parametric graphic engine + APP-6D/MIL-STD-2525 symbol catalog, adapter-agnostic overlay rendering and editing handles, with a MapLibre adapter and React hooks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./symbols": {
      "types": "./dist/symbols/index.d.ts",
      "import": "./dist/symbols/index.js",
      "require": "./dist/symbols/index.cjs"
    },
    "./symbols/individual": {
      "types": "./dist/symbols/individual/index.d.ts",
      "import": "./dist/symbols/individual/index.js",
      "require": "./dist/symbols/individual/index.cjs"
    },
    "./adapter": {
      "types": "./dist/adapter/index.d.ts",
      "import": "./dist/adapter/index.js",
      "require": "./dist/adapter/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./maplibre": {
      "types": "./dist/maplibre/index.d.ts",
      "import": "./dist/maplibre/index.js",
      "require": "./dist/maplibre/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./milsymbol": {
      "types": "./dist/milsymbol/index.d.ts",
      "import": "./dist/milsymbol/index.js",
      "require": "./dist/milsymbol/index.cjs"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js",
      "require": "./dist/extension/index.cjs"
    },
    "./orders": {
      "types": "./dist/orders/index.d.ts",
      "import": "./dist/orders/index.js",
      "require": "./dist/orders/index.cjs"
    },
    "./geojson": {
      "types": "./dist/geojson/index.d.ts",
      "import": "./dist/geojson/index.js",
      "require": "./dist/geojson/index.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.df396b79-3da5-473f-91c2-7be67d95c46c/contents/release/npm/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke-test.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "maplibre-gl": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "milsymbol": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "milsymbol": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "jsdom": "^26.1.0",
    "maplibre-gl": "^5.0.0",
    "milsymbol": "^3.0.4",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "app6d",
    "mil-std-2525",
    "sidc",
    "nato",
    "tactical-graphics",
    "maplibre",
    "military-symbology",
    "parametric-graphics"
  ]
}
