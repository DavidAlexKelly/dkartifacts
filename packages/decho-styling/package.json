{
  "name": "@acc/decho-styling",
  "version": "1.3.1",
  "description": "The Decho design tokens: eight themes as values and as CSS custom properties, with helpers for re-tinting a theme and defining your own. No React and no components — those are @acc/decho-components, which depends on neither this package nor a stylesheet. Ships its own adoption codemod, Blueprint adapter and lint rule.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "bin",
    "eslint",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "CHANGELOG.md",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/css/tokens.css",
    "./blueprint.css": "./src/css/blueprint.css",
    "./compat/military.css": "./src/css/compat/military.css",
    "./tokens.json": "./src/tokens.json",
    "./eslint": "./eslint/index.js"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.b39ad0fb-63f7-4297-9d23-d029564ce937/contents/release/npm/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run",
    "tokens": "npm run build && node scripts/gen-tokens-css.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18",
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  },
  "bin": {
    "decho": "./bin/decho.mjs"
  }
}
