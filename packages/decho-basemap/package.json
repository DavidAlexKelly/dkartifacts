{
  "name": "@acc/decho-basemap",
  "version": "0.11.0",
  "description": "A MapLibre vector basemap served entirely from Foundry — PMTiles, glyphs and sprites from datasets or media sets, with no external network calls.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "!**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://accenture.palantirfoundry.com/artifacts/api/repositories/ri.artifacts.main.repository.df396b79-3da5-473f-91c2-7be67d95c46c/contents/release/npm/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm test && npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@acc/decho-foundry-bytes": "^0.1.0",
    "@osdk/client": "^2.0.0",
    "@osdk/foundry.datasets": "^2.0.0",
    "@osdk/foundry.mediasets": "^2.0.0",
    "@protomaps/basemaps": "^5.7.2",
    "maplibre-gl": "^5.0.0 || ^6.0.0",
    "pmtiles": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@protomaps/basemaps": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.5.4",
    "vitest": "^3.2.4"
  }
}
